# One of the two backends. Leave ANTHROPIC_API_KEY empty to use the Codex route.
ANTHROPIC_API_KEY=
# ARCHITECT_PROVIDER=auto      # anthropic | codex | auto (anthropic if a key is set, else codex if `codex login` has run)
# ARCHITECT_MODEL=claude-sonnet-5
# CODEX_MODEL=gpt-5.5
# CODEX_REASONING=medium       # low | medium | high

# Tracing (optional): the full trace of every conversation as a hierarchy in LangSmith (pip install -e .[trace]).
# Off unless the key is set. One trace per conversation, one run per turn under its root, model calls and tool calls
# under the turn, the validator's verdict as a run and as score_* metadata on the turn. Keys and emails are masked.
# LANGSMITH_API_KEY=                       # LANGCHAIN_API_KEY is read too
# LANGSMITH_PROJECT=anaplan-architect
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com     # https://eu.api.smith.langchain.com for the EU region
# LANGSMITH_TRACE_CONTENT=0                # a ceiling for the whole instance: nobody's questions go above structure (calls, order, sizes,
#                                          # tokens, cost, timings, the verdict). Unset: each login's own level applies (Settings). The admin's
#                                          # questions are traced in full by default; every other login sends nothing until it turns that on.
# LANGSMITH_TRACE_MATERIAL=1               # also send the estate material's text (never sent otherwise)

# Hosting (optional)
# ARCHITECT_HOSTED=1                       # behind a proxy that ends TLS: Secure cookies, HSTS, forwarded scheme and address believed, API docs off
# ARCHITECT_MAX_UPLOAD_MB=200              # the most one request may carry
