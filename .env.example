# Copy this file to .env and fill in ONE of the five model blocks below. Leave the others commented out.
# .env is gitignored and stays on this machine. Docker (docker compose up) reads the same file; on a server, set the
# same names as service variables instead.
#
# Without a model the app still opens, reads exports and shows the demo; it cannot answer questions, and says so.

# Which block to use: anthropic | bedrock | azure | openai | codex | auto
# auto (the default) picks anthropic when its key is set, else openai when its block is filled, else codex when
# `codex login` has run. bedrock and azure are never picked by auto: name them here.
# ARCHITECT_PROVIDER=auto

# --- 1. anthropic: an Anthropic API key -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ARCHITECT_MODEL=claude-sonnet-5
# Only for a gateway or proxy in front of the Anthropic API:
# ANTHROPIC_BASE_URL=

# --- 2. openai: OpenAI, or any OpenAI-compatible endpoint (one inside your organisation, a local model server) ---
# ARCHITECT_PROVIDER=openai
# OPENAI_API_KEY=
# The model the endpoint serves (required):
# ARCHITECT_MODEL=
# Leave out for api.openai.com; set for any other endpoint, for example http://localhost:11434/v1
# OPENAI_BASE_URL=

# --- 3. azure: Azure OpenAI --------------------------------------------------------------------------------------
# ARCHITECT_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# Optional:
# AZURE_OPENAI_API_VERSION=

# --- 4. bedrock: Claude on Amazon Bedrock (install with the bedrock extra) ---------------------------------------
# Credentials come from the usual AWS chain (a profile, the standard AWS key variables, or the machine's role).
# ARCHITECT_PROVIDER=bedrock
# AWS_REGION=eu-west-2
# The Bedrock model id (required):
# ARCHITECT_MODEL=

# --- 5. codex: a ChatGPT subscription, through `codex login` on this machine. No key in this file ---------------
# ARCHITECT_PROVIDER=codex
# CODEX_MODEL=gpt-5.5
# low, medium or high:
# CODEX_REASONING=medium
# Only if the Codex login is not in ~/.codex:
# CODEX_HOME=

# Tracing (optional): the full trace of every conversation as a hierarchy in LangSmith (pip install -e .[trace]).
# Off unless the key is set. One trace per conversation, one run per turn under its root, model calls and tool calls
# under the turn, the validator's verdict as a run and as score_* metadata on the turn. Keys and emails are masked.
# LANGSMITH_API_KEY=                       # LANGCHAIN_API_KEY is read too
# LANGSMITH_PROJECT=anaplan-architect
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com     # https://eu.api.smith.langchain.com for the EU region
# LANGSMITH_TRACE_CONTENT=0                # a ceiling for the whole instance: nobody's questions go above structure (calls, order, sizes,
#                                          # tokens, cost, timings, the verdict). Unset: each login's own level applies (Settings). The admin's
#                                          # questions are traced in full by default; every other login sends nothing until it turns that on.
# LANGSMITH_TRACE_MATERIAL=1               # also send the estate material's text (never sent otherwise)

# Hosting (optional)
# ARCHITECT_HOSTED=1                       # behind a proxy that ends TLS: Secure cookies, HSTS, forwarded scheme and address believed, API docs off
# ARCHITECT_MAX_UPLOAD_MB=200              # the most one request may carry
# Several people at once (docs/features/hosting.md): the defaults suit about eight people on 1 GB
# ARCHITECT_MAX_CHATS_PER_LOGIN=2          # answers one login may have in flight
# ARCHITECT_MAX_CHATS=16                   # answers in flight on the whole instance
# ARCHITECT_MAX_EXPORT_READS=2             # sets of exports read at once
